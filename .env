# Postgres
POSTGRES_DB=crime_sim
POSTGRES_USER=crime_user
POSTGRES_PASSWORD=supersecret

# Flask / API
FLASK_ENV=production
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=postgresql+psycopg2://crime_user:supersecret@db:5432/crime_sim
CORS_ORIGINS=http://localhost:5173,http://localhost

# Seeding
SEED_INCIDENTS=1500
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=AdminPass!123
DEFAULT_ANALYST_EMAIL=analyst@example.com
DEFAULT_ANALYST_PASSWORD=password123
